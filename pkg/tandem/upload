#!/bin/bash
# Tandem plugin: uploads the selected files with fb and copies the link.
# Several files become one collection, like fb-upload does.
#
#   upload CHOICE FILE...   CHOICE is one of the entries --choices prints
#   upload --choices        the entries of the "Upload to filebin" submenu
set -uo pipefail

if [[ ${1-} == --choices ]]; then
    # Labels only: Tandem shows the chosen one while uploading.
    printf '%s\n' "No expiry" "1 hour" "1 day" "1 week" "1 month" "Burn after reading"
    exit 0
fi

choice=${1-}
shift
(( $# )) || { echo "Nothing selected" >&2; exit 1; }
for f in "$@"; do
    [[ -d $f ]] && { echo "Folders can't be uploaded: ${f##*/}" >&2; exit 1; }
done

args=()
case $choice in
"No expiry") ;;
"1 hour") args+=(-e 1h) ;;
"1 day") args+=(-e 1d) ;;
"1 week") args+=(-e 1w) ;;
"1 month") args+=(-e 1m) ;;
"Burn after reading") args+=(-b) ;;
*) echo "Unknown choice: $choice" >&2; exit 1 ;;
esac
(( $# > 1 )) && args+=(-C)

# fb would copy too, but with its clipboard tool on our output; copy here instead.
err=$(mktemp) && trap 'rm -f "$err"' EXIT
if ! out=$(FB_CLIP=none fb "${args[@]}" "$@" 2>"$err"); then
    msg=$(sed -n '1s/^error: //p' "$err")
    echo "Upload failed: ${msg:-fb exited with an error}" >&2
    exit 1
fi
if (( $# > 1 )); then
    url=$(sed -n 's/^collection: //p' <<<"$out")
else
    url=$(tail -n1 <<<"$out")
fi
[[ -n $url ]] || { echo "Upload failed: fb printed no link" >&2; exit 1; }

copied=false
if [[ ${FB_CLIP:-auto} != none ]]; then
    if [[ -n ${WAYLAND_DISPLAY-} ]] && command -v wl-copy >/dev/null; then
        printf '%s' "$url" | wl-copy >/dev/null 2>&1 && copied=true
    elif [[ -n ${DISPLAY-} ]] && command -v xclip >/dev/null; then
        printf '%s' "$url" | xclip -selection clipboard >/dev/null 2>&1 && copied=true
    fi
fi

what=${1##*/}
(( $# > 1 )) && what="$# files"
# A plain line: Tandem shows it in the status line.
if $copied; then
    printf 'Link to %s copied: %s\n' "$what" "$url"
else
    printf 'Uploaded %s: %s\n' "$what" "$url"
fi
