#!/bin/bash
set -e

# Config: override via env or ~/.config/fb/config
: "${FB_SERVER:=http://localhost:7995}"
: "${FB_KEY:=}"
: "${FB_KEY_FILE:=${XDG_CONFIG_HOME:-$HOME/.config}/fb/apikey}"
: "${FB_CLIP:=auto}"

# Load config file
conf="${XDG_CONFIG_HOME:-$HOME/.config}/fb/config"
[[ -f "$conf" ]] && source "$conf"

# Load API key
[[ -z "$FB_KEY" && -f "$FB_KEY_FILE" ]] && FB_KEY=$(<"$FB_KEY_FILE")

die()  { printf 'error: %s\n' "$1" >&2; exit 1; }
need_key() { [[ -n "$FB_KEY" ]] || die "no API key — set FB_KEY or put it in $FB_KEY_FILE"; }

clip() {
  [[ "$FB_CLIP" == "none" ]] && return
  if [[ "$FB_CLIP" == "auto" ]]; then
    if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy &>/dev/null; then
      printf '%s' "$1" | wl-copy
    elif [[ -n "$DISPLAY" ]] && command -v xclip &>/dev/null; then
      printf '%s' "$1" | xclip -selection clipboard
    elif command -v pbcopy &>/dev/null; then
      printf '%s' "$1" | pbcopy
    fi
  fi
}

# run curl, store body in $resp; on HTTP errors die with the server's error message
call() {
  local out code msg
  out=$(curl -sS -w '\n%{http_code}' "$@") || die "request to $FB_SERVER failed"
  code=${out##*$'\n'}
  resp=${out%$'\n'*}
  if (( code >= 400 )); then
    msg=$(printf '%s' "$resp" | json_field error)
    die "${msg:-HTTP $code}"
  fi
}

json_field() {
  python3 -c "
import json,sys
v = json.load(sys.stdin).get('$1')
print('' if v is None else v)
" 2>/dev/null || sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"
}

# file URLs from an upload response ({"files":[...],"collection":...})
parse_urls() {
  printf '%s' "$1" | python3 -c "
import json,sys
d = json.load(sys.stdin)
for f in (d['files'] if isinstance(d, dict) else d):
    print(f['url'])
" 2>/dev/null || printf '%s' "$1" | sed 's/"collection":{.*//' | grep -o '"url":"[^"]*"' | sed 's/"url":"\(.*\)"/\1/'
}

parse_col_url() {
  printf '%s' "$1" | python3 -c "
import json,sys
c = json.load(sys.stdin).get('collection')
if c: print(c['url'])
" 2>/dev/null || printf '%s' "$1" | sed -n 's/.*"collection":{.*"url":"\([^"]*\)".*/\1/p'
}

# json string escaping for hand-built request bodies
jstr() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# --- commands ---

cmd_upload() {
  need_key
  local args=()
  [[ -n "$OPT_PASSWORD" ]] && args+=(-F "password=$OPT_PASSWORD")
  [[ -n "$OPT_EXPIRES" ]] && args+=(-F "expires=$OPT_EXPIRES")
  [[ "$OPT_BURN" == "1" ]] && args+=(-F "burn=true")
  [[ "$OPT_COLLECT" == "1" ]] && args+=(-F "collection=true")

  # stdin → temp file
  if (( $# == 0 )); then
    local tmp
    tmp=$(mktemp "/tmp/fb-XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    [[ -t 0 ]] && printf '^D to send, ^C to cancel\n' >&2
    cat > "$tmp"
    args+=(-F "file=@$tmp;filename=${OPT_NAME:-paste.txt}")
  else
    for f in "$@"; do
      [[ -f "$f" ]] || die "not a file: $f"
      args+=(-F "file=@$f")
    done
    [[ "$OPT_COLLECT" == "1" && -n "$OPT_NAME" ]] && args+=(-F "collection_name=$OPT_NAME")
  fi

  call -H "Authorization: Bearer $FB_KEY" "${args[@]}" "$FB_SERVER/api/upload"

  local urls col_url
  urls=$(parse_urls "$resp")
  printf '%s\n' "$urls"

  if [[ "$OPT_COLLECT" == "1" ]]; then
    col_url=$(parse_col_url "$resp")
    if [[ -n "$col_url" ]]; then
      printf 'collection: %s\n' "$col_url"
      clip "$col_url"
      return
    fi
  fi

  clip "$(tail -1 <<< "$urls")"
}

cmd_delete() {
  need_key
  for id in "$@"; do
    id=${id#"$FB_SERVER/"}
    id=${id%%/*}
    local qs=""
    [[ "$OPT_DEL_FILES" == "1" ]] && qs="?files=true"
    if ( call -X DELETE -H "Authorization: Bearer $FB_KEY" "$FB_SERVER/api/$id$qs" ); then
      printf 'deleted: %s\n' "$id"
    else
      printf 'failed:  %s\n' "$id" >&2
    fi
  done
}

cmd_get() {
  local args=()
  [[ -n "$OPT_PASSWORD" ]] && args+=(-H "X-Password: $OPT_PASSWORD")
  # the owner's key bypasses passwords and does not trigger burn-after-reading
  [[ -n "$FB_KEY" ]] && args+=(-H "Authorization: Bearer $FB_KEY")
  for id in "$@"; do
    id=${id#"$FB_SERVER/"}
    id=${id%%/*}
    curl -sf "${args[@]}" "$FB_SERVER/$id/raw" || die "could not fetch $id"
  done
}

cmd_history() {
  need_key
  call -H "Authorization: Bearer $FB_KEY" "$FB_SERVER/api/history"

  if [[ "$OPT_RAW" == "1" ]]; then
    printf '%s' "$resp" | python3 -c "
import json,sys
d = json.load(sys.stdin)
for f in d['files']:
    print('\t'.join([f['id'], f['name'], f['mimetype'], str(f['size']), str(f['date'])]))
for c in d['collections']:
    print('\t'.join([c['id'], str(len(c['files'])) + ' file(s)', 'collection', str(c.get('size', '')), str(c['date'])]))
"
    return
  fi

  printf '%s' "$resp" | python3 -c "
import json,sys,datetime,time
d = json.load(sys.stdin)
def size(sz):
    if sz > 1048576: return '%.1f MiB' % (sz/1048576)
    if sz > 1024:    return '%.1f KiB' % (sz/1024)
    return '%d B' % sz
def flags(x):
    s = ('P' if x.get('protected') else '-') + ('B' if x.get('burn') else '-')
    e = x.get('expires') or 0
    if e:
        left = e - time.time()
        s += ' %dd' % (left // 86400) if left >= 86400 else ' %dh' % max(0, left // 3600)
    return s
fmt = '%-8s  %-30s  %-24s  %10s  %-16s  %s'
print(fmt % ('ID','NAME','TYPE','SIZE','DATE','FLAGS'))
print('-' * 106)
for f in d['files']:
    dt = datetime.datetime.fromtimestamp(f['date']).strftime('%Y-%m-%d %H:%M')
    print(fmt % (f['id'], f['name'][:30], f['mimetype'].split(';')[0][:24], size(f['size']), dt, flags(f)))
for c in d['collections']:
    dt = datetime.datetime.fromtimestamp(c['date']).strftime('%Y-%m-%d %H:%M')
    name = (c.get('name') or 'Collection') + ' (%d)' % len(c['files'])
    print(fmt % (c['id'], name[:30], 'collection', size(c.get('size', 0)), dt, flags(c)))
print()
print('total: %d files, %d collections, %.1f MiB' % (
    len(d['files']), len(d['collections']), d['total_size']/1048576))
print('flags: P = password, B = burn after reading, Nd/Nh = expires in')
"
}

cmd_collection() {
  need_key
  (( $# >= 1 )) || die "usage: fb -c ID [ID...]"
  local ids="" sep=""
  for id in "$@"; do
    id=${id#"$FB_SERVER/"}
    id=${id%%/*}
    ids+="${sep}$(jstr "$id")"
    sep=","
  done
  local body="{\"ids\":[$ids]"
  [[ -n "$OPT_PASSWORD" ]] && body+=",\"password\":$(jstr "$OPT_PASSWORD")"
  [[ -n "$OPT_NAME" ]] && body+=",\"name\":$(jstr "$OPT_NAME")"
  [[ -n "$OPT_EXPIRES" ]] && body+=",\"expires\":$(jstr "$OPT_EXPIRES")"
  body+="}"
  call -H "Authorization: Bearer $FB_KEY" -H "Content-Type: application/json" \
    -d "$body" "$FB_SERVER/api/collection"
  local url
  url=$(printf '%s' "$resp" | json_field url)
  printf '%s\n' "$url"
  clip "$url"
}

# --- main ---

usage() {
  cat >&2 <<EOF
usage: fb [options] [file...]

  fb file.txt              upload file(s)
  fb -p PASS file.txt      upload with password protection
  fb a.txt b.png           upload multiple files
  fb -C a.txt b.png        upload and create collection
  fb -C -n Trip *.jpg      upload into a collection named "Trip"
  fb -e 1d file.txt        upload, expire after one day
  fb -b secret.txt         burn after reading (deleted after first view)
  fb                       upload from stdin
  echo hi | fb             pipe to upload
  fb -d ID [ID...]         delete
  fb -dF ID                delete collection and its files
  fb -g ID [ID...]         download to stdout
  fb -g -p PASS ID         download password-protected file
  fb -H                    show history (table)
  fb -Hr                   show history (tsv, machine-readable)
  fb -c ID [ID...]         create collection (-n NAME, -p PASS, -e EXPIRY)

examples:
  fb -Hr | grep image/jpeg | cut -f1 | xargs fb -d
  fb -Hr | awk -F'\t' '\$1 ~ /^foo/' | cut -f1 | xargs fb -d

options:
  -b         burn after reading
  -C         also create a collection of the uploaded files
  -e EXPIRY  expire after 1h, 1d, 1w, 1m, never, or N seconds
  -F         also delete files inside collections (with -d)
  -n NAME    filename for stdin upload, or collection name (-C/-c)
  -p PASS    password protect upload, or unlock on download
  -r         raw/tsv output (for -H)
  -s SERVER  server URL (default: \$FB_SERVER)
  -v         version

env:
  FB_SERVER   server URL
  FB_KEY      API key (or put in ~/.config/fb/apikey)
  FB_CLIP     clipboard: auto, none
EOF
  exit 1
}

OPT_NAME=""
OPT_COLLECT=""
OPT_RAW=""
OPT_DEL_FILES=""
OPT_PASSWORD=""
OPT_EXPIRES=""
OPT_BURN=""
MODE="upload"

while getopts "n:s:p:e:bdDgGHhcCFrv" opt; do
  case "$opt" in
    n) OPT_NAME="$OPTARG" ;;
    s) FB_SERVER="$OPTARG" ;;
    p) OPT_PASSWORD="$OPTARG" ;;
    e) OPT_EXPIRES="$OPTARG" ;;
    b) OPT_BURN="1" ;;
    d|D) MODE="delete" ;;
    g|G) MODE="get" ;;
    H) MODE="history" ;;
    c) MODE="collection" ;;
    C) OPT_COLLECT="1" ;;
    F) OPT_DEL_FILES="1" ;;
    r) OPT_RAW="1" ;;
    v) echo "fb 1.1.0"; exit 0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

FB_SERVER="${FB_SERVER%/}"

case "$MODE" in
  upload)     cmd_upload "$@" ;;
  delete)     cmd_delete "$@" ;;
  get)        cmd_get "$@" ;;
  history)    cmd_history ;;
  collection) cmd_collection "$@" ;;
esac
